# Copy to .env locally. Replace placeholders only in your private environment.
# Never commit a real .env file.
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.example.com/auth/google/callback
SESSION_SECRET=replace_with_a_long_random_secret

META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
META_REDIRECT_URI=https://your-backend.example.com/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=replace_with_random_webhook_verify_token

# Optional AI service key for the server-side assistant
GEMINI_API_KEY=replace_with_your_key
