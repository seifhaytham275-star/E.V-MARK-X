PORT=8080
# Create a Google OAuth 2.0 Web client ID in Google Cloud Console.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
# Store the Gemini API key ONLY on the backend host. Never place it in config.js or HTML.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Exact public frontend origin, no trailing slash.
FRONTEND_ORIGIN=https://seifhaytham275-star.github.io
# Optional: comma-separated extra allowed origins.
EXTRA_ALLOWED_ORIGINS=
# Optional model list cache duration in seconds.
MODELS_CACHE_SECONDS=300